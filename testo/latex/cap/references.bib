@InProceedings{10.1007/978-3-031-45770-8_29,
	author="Vukolov, Andrey
	and Guzzi, Francesco
	and Pugliese, Roberto
	and Kourousias, George",
	editor="Okada, Masafumi",
	title="Universal Configurable Navigation and Control System for Industrial Unmanned Ground Vehicles with Differential Chassis",
	booktitle="Advances in Mechanism and Machine Science",
	year="2023",
	publisher="Springer Nature Switzerland",
	address="Cham",
	pages="287--301",
	abstract="We describe a novel navigation and control system designed for industrial unmanned ground vehicles, utilizing the Robot Operating System (ROS). Our primary objective was to develop a versatile solution that could adapt to various chassis and robot configurations. The system is characterized by its modularity, reconfigurability, flexibility, and partial hardware/system environment agnosticism. It combines modern SLAM (Simultaneous Localization and Mapping) techniques, advanced trajectory planning algorithms, and robust AI image processing capabilities, all accessible through a user-friendly web frontend. The paper delves into the system's architecture and its seamless integration with the mechanical components. Additionally, it describes some challenges encountered during the implementation of this advanced software, its architecture and interaction with the mechanical part of the system.",
	isbn="978-3-031-45770-8"
}
